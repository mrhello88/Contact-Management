<%- include("../layouts/header.ejs") %>

    <link rel="stylesheet" href="/css/download.css">
    <link rel="stylesheet" href="/css/navbar.css">

</head>
<body>
    <%- include("../layouts/navbar.ejs") %>
    <div class="container">
        <h2>Total Number's in <%= district %> District:<%= count %></h2>
        <form action="/pdfDownload" method="post" class="number-range">
            <input type="hidden" name="_csrf" value="<%= csrfToken%>">
            <div class="form-group">
                <label for="from">From:</label>
                <input type="number" id="from" name="from" placeholder="Enter start number" required>
            </div>
        
            <div class="form-group">
                <label for="to">To:</label>
                <input type="number" id="to" name="to" placeholder="Enter end number" required>
            </div>
            <input type="hidden" name="district" value="<%=district%>">
            <button type="submit" class="submit-button">Download</button>
        </form>
    </div>
<%- include("../layouts/footer.ejs") %>

